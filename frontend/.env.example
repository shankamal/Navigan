# Custom Cognito SRP login: public app client without a secret. See docs/custom-login.md.
# Server-only upstream. The SAM gateway stage is /v1, and the API prefix is /api/v1.
NAVIGAN_API_ORIGIN=https://q0i8bcekw1.execute-api.ap-south-1.amazonaws.com
NAVIGAN_API_BASE_PATH=/v1/api/v1

# Cognito public app client, without a client secret; SRP authentication.
NEXT_PUBLIC_OIDC_AUTHORITY=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_GtWAW9Owz
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional path to an approved, locally hosted corporate logo asset.
NEXT_PUBLIC_CORPORATE_LOGO_URL=
