# Explicit server-only DEV upstream; supplied at runtime, never baked into images.
NAVIGAN_API_ORIGIN=https://api-dev.navigan.click
NAVIGAN_API_BASE_PATH=/api/v1

# Public runtime allowlist. Use the existing DEV Cognito public client (no secret).
# NAVIGAN_PUBLIC_* is preferred; legacy NEXT_PUBLIC_* is a dynamic fallback.
NAVIGAN_PUBLIC_OIDC_AUTHORITY=
NAVIGAN_PUBLIC_OIDC_CLIENT_ID=
NAVIGAN_PUBLIC_APP_URL=http://localhost:3000
NAVIGAN_PUBLIC_CORPORATE_LOGO_URL=
NAVIGAN_PUBLIC_MIGRATION_CONNECTOR_IMAGE_REPOSITORY=
NAVIGAN_PUBLIC_MIGRATION_CONNECTOR_IMAGE_DIGEST=
NAVIGAN_PUBLIC_MIGRATION_CONNECTOR_API_BASE_URL=
