aws_region                  = "ap-south-1"
environment_name            = "migration-lab"
control_plane_instance_type = "t3.large"
worker_instance_type        = "t3.large"
worker_count                = 2
root_volume_size_gib        = 40
kubernetes_minor_version    = "1.37"
calico_version              = "3.32.2"

# SSM Session Manager is enabled by default. Keep SSH disabled unless needed.
enable_ssh  = false
admin_cidr  = "203.0.113.10/32"
ssh_key_name = null
