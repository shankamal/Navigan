# Copy to config.env (ignored by Git), fill in your values, then source it.
export AWS_REGION=ap-south-1
# Optional: omit to use your current AWS CLI credentials / EC2 instance role.
# export AWS_PROFILE=navigan
export ECR_STACK_NAME=navigan-frontend-ecr
export ECR_REPOSITORY_NAME=navigan/frontend
export FRONTEND_STACK_NAME=navigan-frontend

# Build-time PUBLIC settings. No passwords, access keys or client secrets.
export NEXT_PUBLIC_OIDC_AUTHORITY=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_PD9mv4fkd
export NEXT_PUBLIC_OIDC_CLIENT_ID=aa7v5laqu1mkqamt7ao51u7ms
export NEXT_PUBLIC_OIDC_SCOPE='openid profile email'
export NEXT_PUBLIC_APP_URL=https://navigan.click
export NEXT_PUBLIC_COGNITO_DOMAIN=https://ap-south-1pd9mv4fkd.auth.ap-south-1.amazoncognito.com
export NEXT_PUBLIC_CORPORATE_LOGO_URL=''

# Existing VPC; at least two distinct AZs for public ALB subnets and private task subnets.
export VPC_ID=vpc-015365b45bea2ea7c
export PUBLIC_SUBNET_IDS=subnet-02166f72dc73ac058,subnet-0672975fa0c30f801,subnet-0f4e519be766a574b
export PRIVATE_SUBNET_IDS=subnet-0e6e6dccaa57702bb,subnet-0e0acccb47569d030,subnet-08e8d4757da5b3f02
export CERTIFICATE_ARN=arn:aws:acm:ap-south-1:905418045935:certificate/cc015cf6-7d07-46d4-ba8a-9ccd7844ea5d
# Optional Route 53 public hosted zone for automatic DNS alias creation.
export HOSTED_ZONE_ID=Z06370683QN8IVCV56X0V
export ALLOWED_INGRESS_CIDR=0.0.0.0/0
export MIN_TASKS=1
export MAX_TASKS=2

# Runtime server-only upstream, passed to the task definition. u
export NAVIGAN_API_ORIGIN=https://q0i8bcekw1.execute-api.ap-south-1.amazonaws.com
export NAVIGAN_API_BASE_PATH=/v1/api/v1
