{
  "type": "object",
  "title": "GCP / GKE infrastructure baseline",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "title": "Schema version",
      "const": "1.0"
    },
    "account": {
      "type": "object",
      "title": "Google Cloud project",
      "properties": {
        "projectId": {
          "type": "string",
          "title": "Project ID",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "hostProjectId": {
          "type": "string",
          "title": "Shared VPC host project (optional)",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "title": "Google Cloud network",
      "properties": {
        "networkResourceName": {
          "type": "string",
          "title": "Network resource name",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^projects/[^/]+/global/networks/[^/]+$"
        },
        "subnetworkResourceName": {
          "type": "string",
          "title": "Subnetwork resource name",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^projects/[^/]+/regions/[^/]+/subnetworks/[^/]+$"
        },
        "podSecondaryRangeNames": {
          "type": "array",
          "title": "Approved pod secondary ranges",
          "items": {
            "type": "string",
            "title": "Resource reference",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "serviceSecondaryRangeNames": {
          "type": "array",
          "title": "Approved service secondary ranges",
          "items": {
            "type": "string",
            "title": "Resource reference",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "networkResourceName",
        "subnetworkResourceName",
        "podSecondaryRangeNames",
        "serviceSecondaryRangeNames"
      ],
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "title": "Service accounts",
      "properties": {
        "nodeServiceAccountEmail": {
          "type": "string",
          "title": "Node service account",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^@]+@[^@]+\\.iam\\.gserviceaccount\\.com$"
        }
      },
      "required": [
        "nodeServiceAccountEmail"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "title": "Firewall baseline",
      "properties": {
        "firewallPolicyReferences": {
          "type": "array",
          "title": "Approved firewall policy references",
          "items": {
            "type": "string",
            "title": "Resource reference",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "firewallPolicyReferences"
      ],
      "additionalProperties": true
    },
    "encryption": {
      "type": "object",
      "title": "Encryption",
      "properties": {
        "mode": {
          "type": "string",
          "title": "Encryption mode",
          "enum": [
            "PROVIDER_MANAGED",
            "CUSTOMER_MANAGED"
          ]
        },
        "kmsKeyResourceName": {
          "type": "string",
          "title": "Cloud KMS key reference",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "CUSTOMER_MANAGED"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "kmsKeyResourceName"
            ]
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "title": "Location",
      "properties": {
        "region": {
          "type": "string",
          "title": "Region / location",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "region"
      ],
      "additionalProperties": false
    },
    "connectivity": {
      "type": "object",
      "title": "Connectivity",
      "properties": {
        "egressMode": {
          "type": "string",
          "title": "Approved egress",
          "enum": [
            "NAT",
            "PRIVATE_ENDPOINTS",
            "PROXY"
          ]
        },
        "notes": {
          "type": "string",
          "title": "Connectivity notes",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "egressMode"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "title": "Baseline tags",
      "properties": {
        "Owner": {
          "type": "string",
          "title": "Owner",
          "minLength": 1,
          "maxLength": 1024
        },
        "CostCenter": {
          "type": "string",
          "title": "Cost center",
          "minLength": 1,
          "maxLength": 1024
        },
        "Environment": {
          "type": "string",
          "title": "Environment",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "Owner",
        "CostCenter",
        "Environment"
      ],
      "additionalProperties": true
    },
    "dns": {
      "type": "object",
      "title": "DNS",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "proxy": {
      "type": "object",
      "title": "Proxy references",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "title": "Additional configuration (no secrets)",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  },
  "required": [
    "account",
    "network",
    "identity",
    "security",
    "encryption",
    "location",
    "connectivity",
    "tags"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:navigan:environment:gke:1.0",
  "x-distribution": "GKE",
  "x-provider": "GCP",
  "x-version": "1.0"
}
