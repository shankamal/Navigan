{
  "type": "object",
  "title": "OCI / OKE infrastructure baseline",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "title": "Schema version",
      "const": "1.0"
    },
    "account": {
      "type": "object",
      "title": "OCI tenancy",
      "properties": {
        "tenancyOcid": {
          "type": "string",
          "title": "Tenancy OCID",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^ocid1\\.tenancy\\.[A-Za-z0-9._-]+$"
        },
        "compartmentOcid": {
          "type": "string",
          "title": "Compartment OCID",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^ocid1\\.compartment\\.[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "tenancyOcid",
        "compartmentOcid"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "title": "OCI network",
      "properties": {
        "vcnOcid": {
          "type": "string",
          "title": "VCN OCID",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^ocid1\\.vcn\\.[A-Za-z0-9._-]+$"
        },
        "apiEndpointSubnetOcid": {
          "type": "string",
          "title": "API endpoint subnet OCID",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^ocid1\\.subnet\\.[A-Za-z0-9._-]+$"
        },
        "nodeSubnetOcids": {
          "type": "array",
          "title": "Approved node subnets",
          "items": {
            "type": "string",
            "title": "Subnet OCID",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^ocid1\\.subnet\\.[A-Za-z0-9._-]+$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "loadBalancerSubnetOcids": {
          "type": "array",
          "title": "Load balancer subnets",
          "items": {
            "type": "string",
            "title": "Subnet OCID",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^ocid1\\.subnet\\.[A-Za-z0-9._-]+$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "vcnOcid",
        "apiEndpointSubnetOcid",
        "nodeSubnetOcids"
      ],
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "title": "OCI IAM baseline",
      "properties": {
        "policyOcids": {
          "type": "array",
          "title": "Approved IAM policies",
          "items": {
            "type": "string",
            "title": "Policy OCID",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^ocid1\\.policy\\.[A-Za-z0-9._-]+$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "policyOcids"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "title": "Network security groups",
      "properties": {
        "networkSecurityGroupOcids": {
          "type": "array",
          "title": "Approved NSGs",
          "items": {
            "type": "string",
            "title": "NSG OCID",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^ocid1\\.networksecuritygroup\\.[A-Za-z0-9._-]+$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "networkSecurityGroupOcids"
      ],
      "additionalProperties": true
    },
    "encryption": {
      "type": "object",
      "title": "Encryption",
      "properties": {
        "mode": {
          "type": "string",
          "title": "Encryption mode",
          "enum": [
            "PROVIDER_MANAGED",
            "CUSTOMER_MANAGED"
          ]
        },
        "kmsKeyOcid": {
          "type": "string",
          "title": "Vault key OCID",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^ocid1\\.key\\.[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "CUSTOMER_MANAGED"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "kmsKeyOcid"
            ]
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "title": "Location",
      "properties": {
        "region": {
          "type": "string",
          "title": "Region / location",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "region"
      ],
      "additionalProperties": false
    },
    "connectivity": {
      "type": "object",
      "title": "Connectivity",
      "properties": {
        "egressMode": {
          "type": "string",
          "title": "Approved egress",
          "enum": [
            "NAT",
            "PRIVATE_ENDPOINTS",
            "PROXY"
          ]
        },
        "notes": {
          "type": "string",
          "title": "Connectivity notes",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "egressMode"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "object",
      "title": "Baseline tags",
      "properties": {
        "Owner": {
          "type": "string",
          "title": "Owner",
          "minLength": 1,
          "maxLength": 1024
        },
        "CostCenter": {
          "type": "string",
          "title": "Cost center",
          "minLength": 1,
          "maxLength": 1024
        },
        "Environment": {
          "type": "string",
          "title": "Environment",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "Owner",
        "CostCenter",
        "Environment"
      ],
      "additionalProperties": true
    },
    "dns": {
      "type": "object",
      "title": "DNS",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "proxy": {
      "type": "object",
      "title": "Proxy references",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "title": "Additional configuration (no secrets)",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  },
  "required": [
    "account",
    "network",
    "identity",
    "security",
    "encryption",
    "location",
    "connectivity",
    "tags"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:navigan:environment:oke:1.0",
  "x-distribution": "OKE",
  "x-provider": "OCI",
  "x-version": "1.0"
}
